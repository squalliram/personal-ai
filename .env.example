ACCOUNT_NUMBER=your-octopus-account-number
API_KEY=your-octopus-api-key
# Instagram pipeline (instagram_agent/). Read-only for now: analytics and benchmarks.
INSTAGRAM_ACCESS_TOKEN=your-long-lived-instagram-user-access-token
INSTAGRAM_USER_ID=your-numeric-instagram-professional-account-id
# Daily drafts (python3 -m instagram_agent daily). Cloudflare Workers AI is used when both its values are set
# (free allocation: 10,000 neurons a day); otherwise OpenAI. Force one with INSTAGRAM_AI_PROVIDER=cloudflare|openai.
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_API_TOKEN=your-workers-ai-api-token
# Optional: CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct, CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
OPENAI_API_KEY=your-openai-api-key
# Optional: OPENAI_TEXT_MODEL=gpt-5-mini, OPENAI_IMAGE_MODEL=gpt-image-2.5-flare, OPENAI_IMAGE_SIZE=1024x1280
# Optional: INSTAGRAM_VOICE_FILE=data/instagram/voice.md, INSTAGRAM_SKILLS_DIR=/path/to/instagram-agent-skill/skills
